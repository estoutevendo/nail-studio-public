# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
# O .env fica de fora do Git: não suba o arquivo real.

# --- API ---
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nail
# gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# senha de login do painel web
SENHA_PAINEL=
# chave que o bot usa para falar com a API (invente uma longa)
BOT_API_KEY=
# restrinja ao domínio do painel em produção (padrão: qualquer origem)
# CORS_ORIGINS=https://painel.exemplo.com

# --- e-mails de aviso (Gmail com "senha de app") ---
EMAIL_REMETENTE=
EMAIL_SENHA=
EMAIL_DESTINATARIO=

# --- WhatsApp ---
# número do ateliê: 55 + DDD + número (ex.: 5511900000000)
NUMERO_ATELIE=
# senha do menu admin pelo WhatsApp (mensagem: admin SENHA)
SENHA_ADMIN=
# números que o bot deve ignorar, separados por vírgula (sem o 55)
NUMEROS_BLOQUEADOS=
